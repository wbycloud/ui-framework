# Remove development-only DOM and script before embedding the production page.
function(ui_host_production_page output page)
    foreach(kind HTML SCRIPT)
        if(kind STREQUAL "HTML")
            set(begin "<!-- UI_HOST_DEV_BEGIN -->")
            set(end "<!-- UI_HOST_DEV_END -->")
        else()
            set(begin "/* UI_HOST_DEV_BEGIN */")
            set(end "/* UI_HOST_DEV_END */")
        endif()
        while(TRUE)
            string(FIND "${page}" "${begin}" first)
            string(FIND "${page}" "${end}" last)
            if(first EQUAL -1 AND last EQUAL -1)
                break()
            endif()
            if(first EQUAL -1 OR last LESS first)
                message(FATAL_ERROR "Unbalanced host development section")
            endif()
            string(LENGTH "${end}" end_length)
            math(EXPR tail "${last} + ${end_length}")
            string(SUBSTRING "${page}" 0 ${first} prefix)
            string(SUBSTRING "${page}" ${tail} -1 suffix)
            set(page "${prefix}${suffix}")
        endwhile()
    endforeach()
    set(${output} "${page}" PARENT_SCOPE)
endfunction()

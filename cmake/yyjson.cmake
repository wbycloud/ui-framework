# Vendored dependency identity, checked offline at configure time.
set(_yyjson_root "${CMAKE_CURRENT_LIST_DIR}/../third_party/yyjson")
file(READ "${_yyjson_root}/source-lock.json" _yyjson_lock)
string(JSON _yyjson_commit GET "${_yyjson_lock}" commit)
if(NOT _yyjson_commit STREQUAL "6447536015f3d600f3d65323b10976103b337ca7")
    message(FATAL_ERROR "Unexpected yyjson source identity")
endif()
foreach(_yyjson_file IN ITEMS yyjson.c yyjson.h LICENSE)
    string(JSON _yyjson_expected GET "${_yyjson_lock}" sha256 "${_yyjson_file}")
    file(SHA256 "${_yyjson_root}/${_yyjson_file}" _yyjson_actual)
    if(NOT _yyjson_actual STREQUAL _yyjson_expected)
        message(FATAL_ERROR "yyjson source hash mismatch: ${_yyjson_file}")
    endif()
endforeach()

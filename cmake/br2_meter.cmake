# Optional pinned, locally built pure metering components. No build-time download.
set(UI_BR2_METER_PROGRAM "" CACHE FILEPATH "Matching production BR-2 metering executable")
set(UI_BR2_METER_FIXTURE_PROGRAM "" CACHE FILEPATH "Isolated test-only BR-2 metering executable")
set(_meter_sha "")
set(_meter_fixture_sha "")
foreach(_kind IN ITEMS production fixture)
    if(_kind STREQUAL "production")
        set(_program "${UI_BR2_METER_PROGRAM}")
        set(_destination xuanshu_br2_meter.exe)
    else()
        set(_program "${UI_BR2_METER_FIXTURE_PROGRAM}")
        set(_destination xuanshu_br2_meter_fixture.exe)
    endif()
    if(_program)
        if(NOT EXISTS "${_program}")
            message(FATAL_ERROR "BR-2 metering component does not exist: ${_program}")
        endif()
        file(SHA256 "${_program}" _hash)
        configure_file("${_program}" "${CMAKE_CURRENT_BINARY_DIR}/${_destination}" COPYONLY)
        if(_kind STREQUAL "production")
            set(_meter_sha "${_hash}")
        else()
            set(_meter_fixture_sha "${_hash}")
        endif()
    endif()
endforeach()
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/tools/br2_meter/profile.json" _meter_evidence)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/br2_meter_config.h"
    "#define BR2_METER_SHA256 \"${_meter_sha}\"\n#define BR2_METER_FIXTURE_SHA256 \"${_meter_fixture_sha}\"\n#define BR2_METER_EVIDENCE \"${_meter_evidence}\"\n")
foreach(_target IN ITEMS ui_framework ui_framework_shared ui_framework_edit_test ui_framework_headless)
    if(TARGET ${_target})
        target_include_directories(${_target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
    endif()
endforeach()

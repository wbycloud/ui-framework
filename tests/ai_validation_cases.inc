}
static ui_status_t vc_submit(int kind,const char *client)
{ui_ai_validation_request_t q={0};ui_cap_target_t target={0};q.size=sizeof(q);q.version=1;q.task=(ui_ai_validation_task_t)kind;q.client_request_id=client;if(kind==2){target.size=sizeof(target);target.version=1;CHECK(ui_capability_bind(apps[0].host,"memory.document",&target)==UI_STATUS_OK);q.target=&target;}return ui_ai_validation_propose(s,&q,run);}
static char *vc_unique_read(void)
{char *v=_strdup(rp_read);if(v){char *p=v;while((p=strstr(p,"call-0"))!=NULL){p[0]='R';++p;}}return v;}

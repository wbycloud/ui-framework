  vc_wires(rp_text,NULL,NULL,NULL);CHECK(ui_ai_model_fixture(s,3,"1")==UI_STATUS_OK);CHECK(vc_submit(3,"vc-held-cancel")==UI_STATUS_OK);authorize();DWORD start=GetTickCount();do{pump();if(s->model_config->requests)break;}while(GetTickCount()-start<5000);CHECK(s->model_config->requests==1);CHECK(ui_ai_cancel(s,run)==UI_STATUS_OK);CHECK(ui_ai_service_request_close(s)==UI_STATUS_OK);CHECK(ui_ai_service_destroy(s)==UI_STATUS_PENDING);CHECK(ui_ai_model_fixture(s,3,"0")==UI_STATUS_OK);CHECK(real_wait("\"terminal\":true"));CHECK(vc_state("\"simulated_unknown\":1"));CHECK(strstr(vc_json,"\"reserved\":1"));CHECK(strstr(vc_json,"\"send_entries\":0"));
 }else CHECK(0);

 CHECK(!secret_leaked);printf("RPCP offline %ls: %s; actual network=0\n",mode,vc_json);

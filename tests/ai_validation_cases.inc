#include "ui_framework/ai_validation.h"
__declspec(dllimport) unsigned ui_ai_validation_fixture(ui_ai_service_t *,int);
static char vc_json[4096];static int vc_value=10;
static int vc_state(const char *part)
{DWORD start=GetTickCount();do{char *j=NULL;pump();if(!ui_ai_validation_get_state(s,&j)){strcpy_s(vc_json,sizeof(vc_json),j);ui_ai_release(j);if(strstr(vc_json,part))return 1;}}while(GetTickCount()-start<5000);fprintf(stderr,"validation state %s\n",vc_json);return 0;}
static char *vc_response(const char *wire,int add_usage)
{
 const char *event=strstr(wire,"event: response.completed"),*data=event?strstr(event,"data: "):NULL;if(!data)return _strdup(wire);data+=6;const char *end=strchr(data,'\n');if(!end)return _strdup(wire);if(end>data&&end[-1]=='\r')--end;
 yyjson_doc *doc=yyjson_read(data,(size_t)(end-data),0);CHECK(doc!=NULL);if(!doc)return _strdup(wire);yyjson_mut_doc *copy=yyjson_doc_mut_copy(doc,NULL);yyjson_mut_val *response=yyjson_mut_obj_get(yyjson_mut_doc_get_root(copy),"response");yyjson_mut_obj_remove_str(response,"usage");
 if(add_usage){yyjson_mut_val *usage=yyjson_mut_obj(copy);yyjson_mut_obj_add_uint(copy,usage,"input_tokens",100);yyjson_mut_obj_add_uint(copy,usage,"output_tokens",10);yyjson_mut_obj_add_val(copy,response,"usage",usage);}char *json=yyjson_mut_write(copy,0,NULL);size_t prefix=(size_t)(data-wire),n=prefix+strlen(json)+strlen(end)+1;char *out=malloc(n);if(out){memcpy(out,wire,prefix);strcpy_s(out+prefix,n-prefix,json);strcat_s(out,n,end);}free(json);yyjson_doc_free(doc);yyjson_mut_doc_free(copy);return out;
}
static char *vc_usage(const char *wire){return vc_response(wire,1);}
static void vc_wires(const char *a,const char *b,const char *c,const char *d)
{const char *wires[]={a,b,c,d};yyjson_mut_doc *doc=yyjson_mut_doc_new(NULL);yyjson_mut_val *rows=yyjson_mut_arr(doc);yyjson_mut_doc_set_root(doc,rows);for(unsigned i=0;i<4&&wires[i];++i){char *v=vc_usage(wires[i]);CHECK(v!=NULL);if(v){yyjson_mut_arr_add_strcpy(doc,rows,v);free(v);}}char *json=yyjson_mut_write(doc,0,NULL);CHECK(ui_ai_model_fixture(s,1,json)==UI_STATUS_OK);free(json);yyjson_mut_doc_free(doc);CHECK(ui_ai_model_fixture(s,5,"fixture-key-no-leak")==UI_STATUS_OK);}
static void vc_read(uint64_t id,const ui_cap_target_t *t,const char *params,void *data)
{(void)t;(void)params;(void)data;char json[80];snprintf(json,sizeof(json),"{\"value\":%d,\"revision\":\"r1\"}",vc_value);ui_cap_result_t r={0};r.size=sizeof(r);r.version=1;r.outcome=UI_CAP_OK;r.output_json=json;CHECK(ui_capability_complete(apps[0].host,id,&r)==UI_STATUS_OK);}

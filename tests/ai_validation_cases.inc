  vc_wires(rp_discover,rp_read,rp_text,NULL);CHECK(vc_submit(2,"vc-read")==UI_STATUS_OK);authorize();CHECK(real_wait("\"terminal\":true"));CHECK(strstr(state,"completed"));CHECK(strstr(s->model_config->fixture_body,"revision\\\":\\\"r1"));CHECK(value(0)==10&&vc_value==10);
  vc_wires(rp_text,NULL,NULL,NULL);CHECK(vc_submit(3,"vc-cancel-slot")==UI_STATUS_OK);authorize();CHECK(real_wait("\"terminal\":true"));CHECK(vc_state("\"reserved\":5"));CHECK(strstr(vc_json,"\"task_used\":[1,3,1]"));CHECK(strstr(vc_json,"\"send_entries\":0"));CHECK(strstr(vc_json,"\"simulated_send_entries\":5"));CHECK(strstr(vc_json,"\"estimated_nano_usd\":0"));CHECK(s->model_config->requests==5);CHECK(ui_ai_validation_stop(s)==UI_STATUS_OK);CHECK(vc_submit(2,"sixth-task")==UI_STATUS_ALREADY_EXISTS);
 }else if(!wcscmp(mode,L"vc-limit")){
  char *unique=vc_unique_read();CHECK(unique);vc_wires(rp_discover,rp_read,unique,rp_text);free(unique);CHECK(vc_submit(2,"vc-limited-read")==UI_STATUS_OK);authorize();CHECK(real_wait("\"terminal\":true"));CHECK(vc_state("\"reserved\":3"));CHECK(strstr(vc_json,"validation_quota_or_fee_limit"));CHECK(s->model_config->requests==3);CHECK(strstr(vc_json,"\"manifest\":4"));
 }else if(!wcscmp(mode,L"vc-duplicate")){
  vc_wires(rp_discover,rp_text,NULL,NULL);ui_ai_validation_fixture(s,5);CHECK(vc_submit(2,"vc-duplicate")==UI_STATUS_OK);authorize();CHECK(real_wait("\"terminal\":true"));CHECK(vc_state("validation_duplicate_request"));CHECK(strstr(vc_json,"\"reserved\":1"));CHECK(s->model_config->requests==1);
 }else if(!wcscmp(mode,L"vc-unknown")){
  char *unknown=vc_response(rp_text,0);responses(unknown,NULL);free(unknown);CHECK(vc_submit(1,"vc-no-usage")==UI_STATUS_OK);authorize();CHECK(real_wait("\"terminal\":true"));CHECK(vc_state("\"fee_unknown\":true"));CHECK(strstr(vc_json,"validation_usage_unknown"));CHECK(vc_submit(2,"blocked-after-unknown")==UI_STATUS_PERMISSION_DENIED);CHECK(s->model_config->requests==1);
 }else if(!wcscmp(mode,L"vc-restart")){
  vc_wires(rp_text,NULL,NULL,NULL);CHECK(vc_submit(1,"vc-before-restart")==UI_STATUS_OK);authorize();CHECK(real_wait("\"terminal\":true"));CHECK(vc_state("\"reserved\":1"));close_service();
  ui_ai_service_config_t config={0};config.size=sizeof(config);config.version=1;config.workspace=w;config.storage_path_utf8=dbpath;CHECK(ui_ai_service_create(&config,&s)==UI_STATUS_OK);CHECK(ui_ai_service_open(s)==UI_STATUS_OK);cr_idle();char path[4096];snprintf(path,sizeof(path),"%s.model.json",dbpath);CHECK(ui_ai_model_open(s,path)==UI_STATUS_OK);CHECK(ready_model());ui_ai_validation_desc_t d={0};d.size=sizeof(d);d.version=1;d.validation_id="must-not-reset";d.input_nano_per_token=300;d.output_nano_per_token=1200;CHECK(ui_ai_validation_enable(s,&d)==UI_STATUS_OK);CHECK(vc_state("validation_restart_review_required"));CHECK(strstr(vc_json,"\"reserved\":1"));CHECK(strstr(vc_json,"\"task_used\":[1,0,0]"));CHECK(strstr(vc_json,"\"simulated_send_entries\":1"));CHECK(strstr(vc_json,"\"known_nano_usd\":42000"));CHECK(vc_submit(2,"after-restart")==UI_STATUS_PERMISSION_DENIED);CHECK(s->model_config->requests==0);
 }else if(!wcscmp(mode,L"vc-revision")){
